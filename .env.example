DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
DJANGO_SSL_REDIRECT=false
# Local Docker Compose database only. Use the service connection URL on Codesphere.
DATABASE_URL=postgresql://quotepilot:quotepilot@127.0.0.1:5432/quotepilot
# Server-side Gemini access; never put this in browser code.
GEMINI_API_KEY=
GEMINI_DISCOVERY_MODEL=gemini-4-hydrogen
# Socket timeout for search-backed Gemini calls; other calls use 75 seconds.
GEMINI_SEARCH_TIMEOUT_SECONDS=120
GEMINI_RECOMMENDATION_MODEL=gemini-4-hydrogen

# Maximum concurrent research jobs across worker instances (1–32).
RESEARCH_MAX_RUNNING=8
